{
  "name": "toolbelt",
  "version": "0.1.8",
  "private": false,
  "description": "Small dev tools in one Bun binary, with a React (Ink) TUI",
  "license": "MIT",
  "bin": {
    "tb": "./src/cli.tsx",
    "toolbelt": "./src/cli.tsx"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/cli.tsx",
    "test": "bun test",
    "lint": "bun node_modules/oxlint/dist/cli.js",
    "format": "bun node_modules/oxfmt/dist/cli.js",
    "format:check": "bun node_modules/oxfmt/dist/cli.js --check",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all"
  },
  "dependencies": {
    "immer": "^11.1.17",
    "ink": "^7.1.1",
    "neverthrow": "^8.2.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
